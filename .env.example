# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
DB_HOST=127.0.0.1
DB_NAME=nombre_de_tu_bd_cpanel
DB_USER=usuario_de_tu_bd
DB_PASS=contraseña_fuerte_de_tu_bd
DB_CHARSET=utf8mb4

# ==========================================
# ENTORNO DE APLICACIÓN
# ==========================================
# Cambiar a "production" cuando el sitio esté en vivo
APP_ENV=production
# Cambiar a "false" para no mostrar errores de PHP a los visitantes
APP_DEBUG=false
# La URL real de tu sitio web SIN barra al final
APP_URL=https://htvperu.com.pe

# ==========================================
# SEGURIDAD Y TAREAS (CRON)
# ==========================================
# Token de seguridad para ejecutar cron_backup.php
# IMPORTANTE: Generar uno único con: php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=CAMBIAR_POR_UN_TOKEN_UNICO_Y_SEGURO
