# Forzar codificación UTF-8 para arreglar el problema de las tildes
AddDefaultCharset UTF-8

# Página de error 404 personalizada (MEJ-03-03)
ErrorDocument 404 /404.php

# Activar compresión GZIP/DEFLATE (MEJ-03-04)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Cache-Control para assets estáticos (PRE-PRODUCCION)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Prevenir indexación de respuestas JSON de la API (PRE-PRODUCCION)
<IfModule mod_headers.c>
    <FilesMatch "\.(json)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# Forzar desactivación de exposición de carpetas
Options -Indexes

# Prevenir ataques de Iframe (Clickjacking)
Header set X-Frame-Options "SAMEORIGIN"

# Forzar al navegador a respetar los tipos MIME (Anti-Sniffing)
Header set X-Content-Type-Options "nosniff"

# Protección básica contra XSS en ciertos navegadores (legacy)
Header set X-XSS-Protection "1; mode=block"

# MEJ-07 FIX: Content Security Policy
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com https://cdn.tiny.cloud; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.tiny.cloud; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.google.com; connect-src 'self' https://cdn.tiny.cloud https://get.geojs.io https://api.open-meteo.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com;"

# Referrer Policy
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# MED-08 FIX: HSTS — Forzar HTTPS en navegadores (preload-ready)
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

# Ocultar la firma real del servidor en errores si AllowOverride lo permite
ServerSignature Off

# Protección de archivos de entorno y git si los hubiera
<FilesMatch "^\.|\.env|\.log$|\.cnf$|composer\.json|composer\.lock|package\.json|package-lock\.json|phinx\.php|build_assets\.php|phpunit\.xml">
    Require all denied
</FilesMatch>

# Proteger este mismo archivo
<Files ".htaccess">
    Require all denied
</Files>

# MED-03 FIX: Bloquear archivos de desarrollo/migración/test para producción
<FilesMatch "^(migrate|migration_|read_db|read_news|test_|seed_|fix_|patch_|inject_|refactor|replace|add_|append_|beautify_|check_|crear_|hide_|apply_|remove_|upgrade_|inyectar_|zero_code_|setup_|update_district|db_registro|generar_word|delete_multimedia|restore|get_pagina|take)">
    Require all denied
</FilesMatch>

# Bloquear scripts Python y archivos SQL
<FilesMatch "\.(py|sql)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a conexion.php
<Files "conexion.php">
    Require all denied
</Files>

# Bloquear acceso al documento de auditoría
<Files "AUDITORIA_INTEGRAL_HTVPERU.html">
    Require all denied
</Files>

# MED-NEW-09 FIX: Bloquear acceso a archivos de caché y schema
<FilesMatch "^(home_cache\.json|database_full\.sql)$">
    Require all denied
</FilesMatch>

# CRIT-R03 FIX: Bloquear acceso a la carpeta de cuarentena de desarrollo
# FASE 1: Bloquear acceso web a vendor/ (Composer), app/ (MVC) y core/
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirección Forzada a HTTPS (Producción)
    # NOTA: En localhost/desarrollo esto podría causar problemas si no hay certificado local, 
    # por lo que debe descomentarse en producción o usarse con precaución.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost$
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^app/ - [F,L]
    RewriteRule ^core/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    RewriteRule ^_dev_quarantine/ - [F,L]
    
    # ==========================================
    # FRONT CONTROLLER REDIRECT (MVC REFACTOR)
    # ==========================================
    # PRE-PRODUCCION: La variable BASE_PATH controla el prefijo.
    # En DESARROLLO (XAMPP): /piura_noticias_php
    # En PRODUCCION (raíz):  quitar o dejar vacío estas líneas
    
    # Evitar bucles redirigiendo peticiones ya apuntando a public/
    RewriteCond %{REQUEST_URI} !^/public/
    
    # Excluir archivos y carpetas reales de ser pasados por PHP (CSS, JS, IMAGENES, MANIFEST)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir Sitemaps al directorio public/
    RewriteRule ^sitemap-static\.xml$ public/sitemap-static.xml [L]
    RewriteRule ^sitemap-news-static\.xml$ public/sitemap-news-static.xml [L]

    # Redirigir recursos estáticos (img, uploads, css, js) al directorio public/ si no existen en el raíz
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(img|uploads|css|js|assets|vendor)/(.*)$ public/$1/$2 [L]

    # Enviar todo el resto a public/index.php
    RewriteRule ^(.*)$ public/index.php [L,QSA]

</IfModule>
