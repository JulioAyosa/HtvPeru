{
    "name": "htvperu/piura-noticias",
    "description": "CMS de noticias para HTVPERU - Piura Noticias",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.10",
        "robmorgan/phinx": "^0.16.11",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Config\\": "config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "*"
    }
}
